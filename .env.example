# Polar.sh Payment Integration
# Polar.sh Dashboard'dan alınacak değerler

# Organization ID - Polar Organization Settings'den
VITE_POLAR_ORG_ID=your_polar_organization_id

# Product IDs - Polar Dashboard > Products'dan
VITE_POLAR_PRO_MONTHLY_ID=your_monthly_product_id
VITE_POLAR_PRO_YEARLY_ID=your_yearly_product_id

# Environment: 'sandbox' (test) veya 'production' (canlı)
VITE_POLAR_ENV=sandbox
